          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"${namespace}\",job=\"${job}\",path!~\"readyz|healthz|metrics\"}[1m])))",
          "legendFormat": "p99",
          "refId": "C"
