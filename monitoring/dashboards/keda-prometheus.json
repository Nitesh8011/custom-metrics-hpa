      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_deployment_status_replicas{namespace=\"${namespace}\",deployment=\"${worker}\"}",
          "legendFormat": "",
          "refId": "A"
