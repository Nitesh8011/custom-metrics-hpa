{
  "uid": "keda-prom-autoscaling",
  "title": "KEDA + Prometheus Autoscaling",
  "description": "Overview of the 5 Prometheus metrics KEDA scales on. Use the 'KEDA dashboards' dropdown for one dashboard per load type.",
  "tags": [
    "keda",
    "keda-demo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "title": "KEDA dashboards",
      "tags": [
        "keda-demo"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "tooltip": "",
      "url": "",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "type": "constant",
        "name": "namespace",
        "label": "namespace",
        "query": "app",
        "hide": 2,
        "current": {
          "text": "app",
          "value": "app"
        },
        "options": [
          {
            "selected": true,
            "text": "app",
            "value": "app"
          }
        ]
      },
      {
        "type": "constant",
        "name": "web",
        "label": "web",
        "query": "podinfo-d",
        "hide": 2,
        "current": {
          "text": "podinfo-d",
          "value": "podinfo-d"
        },
        "options": [
          {
            "selected": true,
            "text": "podinfo-d",
            "value": "podinfo-d"
          }
        ]
      },
      {
        "type": "constant",
        "name": "job",
        "label": "job",
        "query": "podinfo-svc",
        "hide": 2,
        "current": {
          "text": "podinfo-svc",
          "value": "podinfo-svc"
        },
        "options": [
          {
            "selected": true,
            "text": "podinfo-svc",
            "value": "podinfo-svc"
          }
        ]
      },
      {
        "type": "constant",
        "name": "worker",
        "label": "worker",
        "query": "worker-d",
        "hide": 2,
        "current": {
          "text": "worker-d",
          "value": "worker-d"
        },
        "options": [
          {
            "selected": true,
            "text": "worker-d",
            "value": "worker-d"
          }
        ]
      },
      {
        "type": "constant",
        "name": "so_web",
        "label": "so_web",
        "query": "podinfo.*",
        "hide": 2,
        "current": {
          "text": "podinfo.*",
          "value": "podinfo.*"
        },
        "options": [
          {
            "selected": true,
            "text": "podinfo.*",
            "value": "podinfo.*"
          }
        ]
      },
      {
        "type": "constant",
        "name": "so_worker",
        "label": "so_worker",
        "query": "worker.*",
        "hide": 2,
        "current": {
          "text": "worker.*",
          "value": "worker.*"
        },
        "options": [
          {
            "selected": true,
            "text": "worker.*",
            "value": "worker.*"
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "**Overview of everything.** For one dashboard per load type (with per-pod breakdowns) use the **KEDA dashboards** dropdown at the top: RPS, latency, concurrency, CPU, queue."
      },
      "transparent": true,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Web pods",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_deployment_status_replicas{namespace=\"${namespace}\",deployment=\"${web}\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Requests / s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(http_request_duration_seconds_count{namespace=\"${namespace}\",job=\"${job}\",path!~\"readyz|healthz|metrics\"}[1m])) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 3,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "description": "",
